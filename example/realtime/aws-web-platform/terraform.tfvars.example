environment         = "development"
region              = "us-east-1"
availability_zone   = "us-east-1a"
secondary_availability_zone = "us-east-1b"
ami_id              = "ami-replace-with-a-current-image"
assets_bucket_name  = "replace-with-a-globally-unique-bucket"
db_username         = "appuser"
db_password         = "replace-through-a-secret-store"
lambda_role_arn     = "arn:aws:iam::123456789012:role/event-processor"
lambda_code_bucket  = "replace-with-a-deployment-bucket"
lambda_code_key     = "releases/event-processor.zip"
