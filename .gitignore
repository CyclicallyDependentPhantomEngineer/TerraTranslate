# Compiled binaries. `go build -o ./bin/terra-translate .` produces an
# 11 MB executable that is rebuilt from source in seconds; see setup.md.
/bin/
/terra-translate
*.exe

# Go build and test artifacts
*.test
*.out
coverage.txt
coverage.html

# Translation output. Every example in the docs writes to a temporary
# directory, but a stray run against the repository root should not be
# committed by accident.
/terra-translate-output/
/terra-translate-terragrunt-output/
/translated/
/migration/
**/translation_report.json
**/terragrunt_translation_report.json

# Terraform working state. Never commit provider binaries, state, or
# credentials: state files routinely contain secrets in plaintext.
.terraform/
.terraform.lock.hcl
.terraform-data/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Real variable files. Only terraform.tfvars.example is tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terragrunt
.terragrunt-cache/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# The versioned catalog under catalog/snapshots/ is deliberately tracked.
# See docs/catalog-operations.md for what that costs and how to prune it.
